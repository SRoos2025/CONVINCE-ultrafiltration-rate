cox_spline_ufr <- function (data, ultrafil_var, modality, lower_bound, upper_bound, weights = FALSE) {
    
    # Subset data
    dat_tmp <- filter(data, group == modality)
    #left hand side of formula
    lhs <- "Surv(t_start, t_stop, endpt)~"
    rhs <- paste0("ns(", ultrafil_var, ", df = 3)",
                  #degrees of freedom controls how flexible the curve can be. We choose 4 which is most common
                  "+ age +sex +dial_vintage +phos_pre_mmoll+ sbp_pre + hb_pre_mmoll + SCR_MH_CHF_OCCUR +  SCR_MH_MYO_OCCUR + SCR_MH_DIAB_OCCUR")
    #fit the cox formula
    if(weights) {
        fit <- coxph(as.formula(paste0(lhs, rhs)), data = dat_tmp, 
                     robust = TRUE, 
                     weights = ipcw, 
                     cluster = id)
    } else {
        fit <- coxph(as.formula(paste0(lhs, rhs)), data = dat_tmp, 
                     cluster = id)
    }
    # Get grid of observed values, with centred values for non x-axis variables
    dat_grid <- data.frame(
        x = seq(lower_bound, upper_bound, length.out = 500)
    )
    
    names(dat_grid)[1] <- ultrafil_var
    
    dat_grid$age <- mean(dat_tmp[["age"]])
    dat_grid$sex <- 0
    dat_grid$dial_vintage <- mean(dat_tmp[["dial_vintage"]])
    dat_grid$residual_urine_out <- mean(dat_tmp[["residual_urine_out"]])
    dat_grid$sbp_pre <- mean(dat_tmp[["sbp_pre"]])
    dat_grid$phos_pre_mmoll <- mean(dat_tmp[["phos_pre_mmoll"]])
    dat_grid$SCR_MH_CHF_OCCUR = 0
    dat_grid$SCR_MH_MYO_OCCUR = 0
    dat_grid$SCR_MH_DIAB_OCCUR = 0
    dat_grid$hb_pre_mmoll = mean(dat_tmp[["hb_pre_mmoll"]])
    
    #get predicitons for fit
    lst_predictions <- predict(fit, newdata = dat_grid, se.fit = TRUE)
    
    # Add predictions to grid
    dat_grid %<>% mutate(
        b  = lst_predictions[[1]],
        se = lst_predictions[[2]],
        hr = exp(b),
        ll = exp(b - 1.96 * se),
        ul = exp(b + 1.96 * se))
    
    return(dat_grid)
}
