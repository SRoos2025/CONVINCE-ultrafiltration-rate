fit_wemix <- function(data, outcome) {
    
    formula <- as.formula(
        paste0(
            outcome,
            " ~ visit_time * group + baseline_", outcome,  #fixed effects
            " +(1 | id)"  
        )
    )
    #define weight 1, as WeMix requires 2 weiths minimum
    data[["w2"]] <- 1
    
    mix(
        formula = formula,
        data = data,
        weights = c("ipcw", "w2"))   # only level 1 weights (per individual, no group weights)
}
